# ── Server ────────────────────────────────────────────────────────
PORT=3001

# ── Admin ─────────────────────────────────────────────────────────
# Plain-text password – will be hashed at startup if ADMIN_PASSWORD_HASH is empty
ADMIN_PASSWORD=changeme123
# Pre-hashed bcrypt value (optional – if set, ADMIN_PASSWORD is ignored)
ADMIN_PASSWORD_HASH=

# ── JWT ───────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string

# ── Stripe ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
FRONTEND_URL=http://localhost:5173

# ── Email (Nodemailer / Gmail App Password) ───────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="LENART Nail Artist <your_email@gmail.com>"

# ── WhatsApp business number (without +) ──────────────────────────
WHATSAPP_NUMBER=351910000000
